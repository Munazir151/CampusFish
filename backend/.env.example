# TinyFish Agent API
TINYFISH_API_KEY=
TINYFISH_BASE_URL=https://agent.tinyfish.ai

# LLM: local Ollama (default). Set LLM_PROVIDER=anthropic to use Claude instead.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=180
LLM_MAX_ITEMS_PER_SCAN=12

# Optional: Claude classification (only when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: Telegram alerts (alerts are still stored and shown in the dashboard)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Optional seed sources for a fresh database (JSON array, any official portal works)
# Example: SEED_SOURCES=[{"name":"National Scholarship Portal","url":"https://scholarships.gov.in/","institution":"Government of India","goal":"List the latest schemes with deadlines and PDF links."}]
SEED_SOURCES=

# Load the bundled sample notices when the database is empty (off by default)
SEED_SAMPLE_DATA=false

# App
DATABASE_PATH=./data/noticeradar.db
SCAN_INTERVAL_MINUTES=30
WATCH_INTERVAL_SECONDS=60
AUTO_SCAN_ON_CHANGE=true
ALERT_GRACE_SECONDS=45
FRONTEND_ORIGIN=http://localhost:3000

# Scan behaviour
ENABLE_PDF_ENRICH=true
ENRICH_MAX_ITEMS=2
AGENT_TIMEOUT_SECONDS=600
ENRICH_TIMEOUT_SECONDS=150
RETRY_EMPTY_SCAN=true
RUN_SCAN_ON_STARTUP=false

